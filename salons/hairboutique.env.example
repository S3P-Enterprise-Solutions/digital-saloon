# Copy to `salons/hairboutique.env` and fill in Hairboutique OHG's Firebase Web SDK config.
VITE_BRAND=hairboutique
VITE_SALON_ID=hairboutique
VITE_SHOW_PRICES=true
BRAND=hairboutique
SALON_ID=hairboutique

# Firebase Web SDK (from Firebase Console -> Project Settings -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hairboutique-ohg.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hairboutique-ohg
VITE_FIREBASE_STORAGE_BUCKET=hairboutique-ohg.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
