# Copy to `functions/.env` for local Functions configuration (gitignored).
# `scripts/start-dev.mjs` sets MAIL_CATCHER_URL and PUBLIC_APP_URL automatically for local dev.

# --- Resend (production / staging email delivery) ---
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=onboarding@resend.dev
# PUBLIC_APP_URL=https://your-salon-domain.example

# --- Local Mail-Catcher (overrides Resend when set) ---
# MAIL_CATCHER_URL=http://127.0.0.1:4105/emails

# --- SMTP, e.g. Gmail (takes precedence over Resend when SMTP_USER + SMTP_PASS are set) ---
# SMTP_USER=yoursalon@gmail.com
# SMTP_PASS=abcdefghijklmnop        # Google App Password, not the account password
# SMTP_HOST=smtp.gmail.com          # default
# SMTP_PORT=465                     # default (587 = STARTTLS)
# SMTP_FROM="KIMM Hair <yoursalon@gmail.com>"   # default: "<salon name>" <SMTP_USER>

# --- Salon identity (per project: functions/.env.<projectId>, e.g. functions/.env.kimm-hair) ---
# BRAND=kimm            # kimm | salon1500 — email design
# SALON_ID=pilot        # Firestore salons/{SALON_ID}

# General operator login (never stored in Firestore)
OPERATOR_EMAIL=operator@salonflow.local
OPERATOR_PASSWORD=SalonFlowOperator!2026


# --- Google Calendar OAuth 2.0 (optional; enables two-way Google Calendar sync) ---
# GOOGLE_OAUTH_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
# GOOGLE_OAUTH_REDIRECT_URI=https://europe-west8-<project-id>.cloudfunctions.net/googleCalendarOAuthCallback
# GOOGLE_OAUTH_STATE_SECRET=random-hmac-secret-at-least-32-chars
