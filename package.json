{
  "name": "react-firebase-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 3100 --host 127.0.0.1",
    "dev:local": "node scripts/start-dev.mjs",
    "dev:salon1500": "node scripts/start-dev.mjs --brand=salon1500",
    "deploy:salon": "node scripts/deploy-salon.mjs",
    "start": "node scripts/start-dev.mjs",
    "start:local": "node scripts/start-dev.mjs",
    "free:ports": "node scripts/free-ports.mjs",
    "emulators": "node scripts/free-ports.mjs && firebase emulators:start --only auth,firestore,storage,functions,ui --project demo-react-firebase-template",
    "seed": "node scripts/seed-emulator.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 3100 --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:functions": "npm --prefix functions test",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:employee": "E2E_EMPLOYEE_ON=1 EMPLOYEE_MANAGEMENT_ENABLED=true VITE_EMPLOYEE_MANAGEMENT_ENABLED=true playwright test",
    "test:e2e:employee-off": "E2E_EMPLOYEE_OFF=1 EMPLOYEE_MANAGEMENT_ENABLED=false VITE_EMPLOYEE_MANAGEMENT_ENABLED=false playwright test",
    "test:e2e:install": "playwright install chromium",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm test:functions",
    "verify:e2e": "pnpm verify && pnpm test:e2e && pnpm test:e2e:employee",
    "deploy": "pnpm build && firebase deploy --only hosting",
    "dev:hairboutique": "node scripts/start-dev.mjs --brand=hairboutique"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "firebase": "^13.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.36.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
