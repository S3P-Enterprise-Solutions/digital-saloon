rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isOperator() {
      return isSignedIn() && request.auth.token.operator == true;
    }

    function isAdmin() {
      return isOperator()
        || (isSignedIn() && userDoc().data.role == 'admin');
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt'])
        && request.resource.data.role == 'user';
      allow update, delete: if false;
    }

    function isBoundedString(value, maxLength) {
      return value is string && value.size() >= 1 && value.size() <= maxLength;
    }

    function isIntInRange(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    function isValidSalon(data) {
      return data.keys().hasOnly(['name', 'address', 'phone', 'email', 'timezone', 'vatId'])
        && data.keys().hasAll(['name', 'address', 'phone', 'email', 'timezone'])
        && isBoundedString(data.name, 120)
        && isBoundedString(data.address, 240)
        && isBoundedString(data.phone, 40)
        && isBoundedString(data.email, 254)
        && isBoundedString(data.timezone, 64)
        && (!('vatId' in data) || isBoundedString(data.vatId, 40));
    }

    function isValidService(data) {
      return data.keys().hasOnly([
          'nameDe', 'nameIt', 'descriptionDe', 'descriptionIt',
          'categoryDe', 'categoryIt',
          'durationMinutes', 'durationMaxMinutes', 'priceCents', 'priceMaxCents', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'nameDe', 'nameIt', 'descriptionDe', 'descriptionIt',
          'durationMinutes', 'priceCents', 'active', 'createdAt', 'updatedAt'
        ])
        && isBoundedString(data.nameDe, 120)
        && isBoundedString(data.nameIt, 120)
        && data.descriptionDe is string && data.descriptionDe.size() <= 1000
        && data.descriptionIt is string && data.descriptionIt.size() <= 1000
        && (!('categoryDe' in data) || (data.categoryDe is string && data.categoryDe.size() <= 80))
        && (!('categoryIt' in data) || (data.categoryIt is string && data.categoryIt.size() <= 80))
        && isIntInRange(data.durationMinutes, 5, 480)
        && (!('durationMaxMinutes' in data) || isIntInRange(data.durationMaxMinutes, 5, 480))
        && isIntInRange(data.priceCents, 0, 999999)
        && (!('priceMaxCents' in data) || isIntInRange(data.priceMaxCents, 0, 999999))
        && data.active is bool
        && isBoundedString(data.createdAt, 40)
        && isBoundedString(data.updatedAt, 40);
    }

    function isValidBookingSettings(data) {
      return data.keys().hasOnly([
          'confirmationMode',
          'slotIntervalMinutes',
          'minAdvanceBookingMinutes',
          'maxAdvanceBookingDays',
          'pendingExpirationHours'
        ])
        && data.keys().hasAll([
          'confirmationMode',
          'slotIntervalMinutes',
          'minAdvanceBookingMinutes',
          'maxAdvanceBookingDays',
          'pendingExpirationHours'
        ])
        && data.confirmationMode in ['AUTOMATIC', 'MANUAL']
        && isIntInRange(data.slotIntervalMinutes, 5, 60)
        && isIntInRange(data.minAdvanceBookingMinutes, 0, 10080)
        && isIntInRange(data.maxAdvanceBookingDays, 1, 365)
        && isIntInRange(data.pendingExpirationHours, 1, 168);
    }

    function isValidHomepageConfig(data) {
      return data.keys().hasOnly(['hiddenSections', 'galleryImages', 'customSections'])
        && data.keys().hasAll(['hiddenSections', 'customSections'])
        && data.hiddenSections is list && data.hiddenSections.size() <= 10
        && data.customSections is list && data.customSections.size() <= 20
        && (!('galleryImages' in data) || (data.galleryImages is list && data.galleryImages.size() <= 60));
    }

    match /salons/{salonId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidSalon(request.resource.data)
        && (resource == null || request.resource.data.timezone == resource.data.timezone);
      allow delete: if isAdmin();

      match /settings/{docId} {
        allow read: if docId == 'homepage' || isAdmin();
        allow create, update: if isAdmin()
          && (docId != 'booking' || isValidBookingSettings(request.resource.data))
          && (docId != 'homepage' || isValidHomepageConfig(request.resource.data));
        allow delete: if isAdmin();
      }

      // Services are deactivated, never deleted: reservations still reference their id.
      match /services/{serviceId} {
        allow read: if resource.data.active == true || isAdmin();
        allow create: if isAdmin() && isValidService(request.resource.data);
        allow update: if isAdmin()
          && isValidService(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /openingHours/{weekday} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /holidays/{holidayId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }

      match /dayExceptions/{exceptionId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }

      match /reservations/{reservationId} {
        // Client SDK: admin read for calendar; all writes go through Cloud Functions.
        allow read: if isAdmin();
        allow write: if false;
      }

      match /blockedSlots/{blockedSlotId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /slotLocks/{lockId} {
        allow read, write: if false;
      }

      match /notificationJobs/{jobId} {
        allow read, write: if false;
      }

      match /employees/{employeeId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /integrations/{integrationId} {
        allow read, write: if false;
      }
    }
  }
}
